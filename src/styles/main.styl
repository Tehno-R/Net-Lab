.content-container img:hover
     transform scale(1.1)

a
  text-decoration none
  color black
  background-color none
  transition background-color 0.5s
  &:hover
    background-color rgba(90, 70, 70, 0.3)

.menu
  padding 20px 10px

.finder
  background-color gray
  height 3%
  text-align center
  padding 0.2% 0

.find-holder
  width 65%

.main-theme
  background-image url("./back_8.jpg")
  background-size cover
  background-position center

.navigate
  padding 1% 4%
  display flex
  flex-direction row
  justify-content right
  gap 30px
  font-size 20px

.main-title
  text-align center
  font-size 50px
  margin-top 10%
  padding-bottom 2%

.content-container
  width 80%
  display grid
  margin 15px auto
  grid-column-gap 50px
  grid-row-gap 20px
  grid-template-columns 2fr 1fr
  text-align center

  &__title
    text-align center

  &__section_right
    background-color #bcb88a

  &__section_left
    background-color #806b2a

  &__bigimg
    img
      width 100%
      height 300px
      height 100px
      object-fit cover

  &__top
    font-size 0

  &__smallimg
    display inline-block
    width 50%
    height 100px
    img
      width 100%
      height 100px
      object-fit cover

  &__title
    display inline-block
    width 50%
    font-size large
    text-align center
    vertical-align top
    padding-top 40px

.topf
  text-align center

.data
  font-size 0

.data_img
  display inline-block
  width 50%
  img
    width 100%
    height 500px
    object-fit cover

.data_text
  display inline-block
  width 50%
  font-size large
  text-align center
  vertical-align top

@media (max-width: 800px)
  .main-theme
    background-image none
  .navigate
    display grid
    grid-template-columns 1fr 1fr
    grid-template-rows 1fr 1fr
    text-align center
    background-color rgb(230, 230, 230)
    row-gap 10px
    column-gap 5px
  .menu
    padding 20px 0
  .main-title
    display none
  .content-container
    grid-template-columns 1fr
    grid-template-rows repeat(auto, 1fr)

  .data_img
    display block
    width 100%

  .data_text
    display block
    width 100%
